{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "db",
      "type": "shell",
      "command": "docker compose up -d --wait db",
      "problemMatcher": []
    },
    {
      "label": "build",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/Pisco.csproj", "/property:GenerateFullPaths=true", "/consoleloggerparameters:NoSummary"],
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "start",
      "dependsOrder": "sequence",
      "dependsOn": ["db", "build"]
    }
  ]
}
