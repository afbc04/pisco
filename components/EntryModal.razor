<div class="editor-backdrop" @onclick="OnClose"></div>
<div class="editor-modal" role="dialog" aria-modal="true">
    <div class="editor-modal-head">
        <h5 class="editor-modal-title">@Title</h5>
        <button type="button" class="editor-close" @onclick="OnClose">&times;</button>
    </div>

    <div class="editor-modal-body">
        <div class="editor-content">
            @ChildContent
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
