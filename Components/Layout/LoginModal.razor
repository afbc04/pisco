@inherits PresenceAware
@inject IStringLocalizer<CommonText> C

<div class="login-scrim" @onclick="OnClose"></div>
<div class="login-card @(Failed ? "is-failed" : null)" role="dialog" aria-modal="true" aria-labelledby="login-title">
    <button type="button" class="login-close" title="@C["Common_Close"]" @onclick="OnClose"><i class="bi bi-x-lg"></i></button>
    <h2 id="login-title" class="login-title">@R["Login_Submit"]</h2>

    <div class="login-admin @PresenceState">
        <img src="img/boria.jpg" alt="" />
        <span>
            <span class="login-admin-name">@AdminName</span>
            <span class="login-admin-status"><span class="live-dot @DotState"></span>@StatusText</span>
        </span>
    </div>

    <form method="post" action="/auth/login">
        <AntiforgeryToken />
        <input type="hidden" name="returnUrl" value="@ReturnUrl" />
        <input type="hidden" name="username" value="@AdminName" autocomplete="username" />
        <div class="login-row">
            <input @ref="password" class="form-control @(Failed ? "is-invalid" : null)" type="password" name="password"
                   placeholder="@R["Login_Password"]" aria-label="@R["Login_Password"]" autocomplete="current-password" required />
            <button class="btn btn-primary" type="submit" title="@R["Login_Submit"]"><i class="bi bi-arrow-right"></i></button>
        </div>
        @if (Failed)
        {
            <p class="login-error"><i class="bi bi-exclamation-circle"></i> @R["Login_WrongPassword"]</p>
        }
    </form>
</div>

@code {
    [Parameter] public string ReturnUrl { get; set; } = "/";
    [Parameter] public bool Failed { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private ElementReference password;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await password.FocusAsync();
    }
}
