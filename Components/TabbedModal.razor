<div class="editor-backdrop" @onclick="OnClose"></div>
<div class="editor-modal tabbed-modal" role="dialog" aria-modal="true" aria-label="@Title">
    <div class="editor-modal-head">
        <h5 class="editor-modal-title">@Title</h5>
        <button type="button" class="editor-close" aria-label="Close" @onclick="OnClose"><i class="bi bi-x-lg"></i></button>
    </div>

    <div class="editor-modal-body">
        <TabView ActiveTab="@ActiveTab" ActiveTabChanged="ActiveTabChanged" Footer="Footer" CollapseLabel="@CollapseLabel" ExpandLabel="@ExpandLabel">
            @ChildContent
        </TabView>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }

    [Parameter] public string? ActiveTab { get; set; }
    [Parameter] public EventCallback<string> ActiveTabChanged { get; set; }
    [Parameter] public string CollapseLabel { get; set; } = "Collapse";
    [Parameter] public string ExpandLabel { get; set; } = "Expand";
}
