    -->
</div>

@code {
    private static DateOnly endOfMonth
    {
        get
        {
            var today = DateTime.Today;
            return new(today.Year, today.Month, DateTime.DaysInMonth(today.Year, today.Month));
        }
    }

    private RenderFragment categoriesButton =>
        @<button type="button" class="kpi-action" title="@R["Fin_Categories_Manage"]">
            <i class="bi bi-tags"></i><span>@R["Fin_Categories"]</span>
        </button>;

    private RenderFragment noPrevious =>
        @<span><span class="delta is-flat">—</span> @R["Fin_Kpi_NoPrevious"]</span>;
}
