
@using System.Security.Claims
@implements IDisposable
@inject WorkspaceState WsState
@inject WalletManager Wallets
@inject AuthenticationStateProvider AuthProvider
@inject ToastService Toasts

<div class="row g-3 mb-4">

    <!-- Revenue KPI -->
    <FinanceKpiCard Label="Income" Icon="bi bi-graph-up-arrow" Color="var(--success)">
        <Action>@categoriesButton(CategoryFlow.Income)</Action>
        <Value>@(0m.ToString("N2")) €</Value>
        <Foot>@noPrevious</Foot>
    </FinanceKpiCard>

    <FinanceKpiCard Label="Expenses" Icon="bi bi-graph-down-arrow" Color="var(--danger)">
        <Action>@categoriesButton(CategoryFlow.Expense)</Action>
        <Value>@(0m.ToString("N2")) €</Value>
        <Foot>@noPrevious</Foot>
    </FinanceKpiCard>

    <FinanceKpiCard Label="Total balance" Icon="bi bi-safe2" Color="var(--balance)">
        <Action>@tagsButton</Action>
        <Value>@WalletMoney.Format(balance)</Value>
        <Foot><span>Initial balance of the published wallets</span></Foot>
    </FinanceKpiCard>

    <div class="col-sm-6 col-xxl-3">
        <div class="panel-card h-100"></div>
    </div>

    <!--
    <FinanceKpiCard Label="Result" Icon="bi bi-plus-slash-minus" Color="var(--primary)">
        <Value>@(0m.ToString("N2")) €</Value>
        <Foot><span>Income − expenses</span></Foot>
    </FinanceKpiCard>

    <FinanceKpiCard Label="Current balance" Icon="bi bi-safe2" Color="var(--balance)">
        <Value>@(0m.ToString("N2")) €</Value>
        <Foot>
            <span class="badge bg-success-subtle text-success-emphasis tnum">@(0m.ToString("N2")) €</span>
            <span>in the period</span>
            <span class="w-100" title="Includes pending payments, card bills and recurring income">
                <i class="bi bi-graph-up-arrow"></i> @endOfMonth.ToString("d MMM"): <b class="text-body-emphasis tnum">@(0m.ToString("N2")) €</b>
            </span>
        </Foot>
    </FinanceKpiCard>
    -->
</div>

@if (categoriesFlow is { } flow)
{
    <CategoriesModal Flow="flow" OnClose="closeCategories" />
}

@if (tagsOpen)
{
    <TagsModal OnClose="closeTags" />
}

@code {
    private bool signedIn;
    private ClaimsPrincipal actor = new();
    private CategoryFlow? categoriesFlow;
    private bool tagsOpen;
    private long balance;

    private static DateOnly endOfMonth
    {
        get
        {
            var today = DateTime.Today;
            return new(today.Year, today.Month, DateTime.DaysInMonth(today.Year, today.Month));
        }
    }

    private RenderFragment? categoriesButton(CategoryFlow flow) => !signedIn || WsState.Current is null ? null :
        @<button type="button" class="btn btn-sm btn-outline-secondary rounded-pill ms-auto py-0 small" title="Manage categories"
                 @onclick="() => openCategories(flow)">
            <i class="bi bi-tags"></i><span>Categories</span>
        </button>;

    private RenderFragment? tagsButton => !signedIn || WsState.Current is null ? null :
        @<button type="button" class="btn btn-sm btn-outline-secondary rounded-pill ms-auto py-0 small" title="Manage tags"
                 @onclick="openTags">
            <i class="bi bi-hash"></i><span>Tags</span>
        </button>;

    protected override async Task OnInitializedAsync()
    {
        WsState.Changed += onWsChanged;
        Wallets.Changed += onWalletsChanged;
        actor = (await AuthProvider.GetAuthenticationStateAsync()).User;
        signedIn = actor.IsSignedIn();
        await WsState.EnsureLoadedAsync();
        loadBalance();
    }

    private void loadBalance()
    {
        if (WsState.Current is not { } ws)
        {
            balance = 0;
            return;
        }
        try
        {
            balance = Wallets.TotalBalance(ws.Id, actor);
        }
        catch (DomainException ex)
        {
            balance = 0;
            Toasts.Error(ex.Message);
        }
    }

    private void onWsChanged() => InvokeAsync(() =>
    {
        categoriesFlow = null;
        tagsOpen = false;
        loadBalance();
        StateHasChanged();
    });

    private void onWalletsChanged() => InvokeAsync(() =>
    {
        loadBalance();
        StateHasChanged();
    });

    private void openCategories(CategoryFlow flow) => categoriesFlow = flow;

    private void closeCategories() => categoriesFlow = null;

    private void openTags() => tagsOpen = true;

    private void closeTags() => tagsOpen = false;

    public void Dispose()
    {
        WsState.Changed -= onWsChanged;
        Wallets.Changed -= onWalletsChanged;
    }

    private RenderFragment noPrevious =>
        @<span><span class="badge bg-body-secondary text-body-secondary">—</span> no data in the previous period</span>;
}
