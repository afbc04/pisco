@inject IStringLocalizer<FinanceText> R

<div class="row g-3 mb-4">

    <!-- Revenue KPI -->
    <FinanceKpiCard Label="@R["Fin_Income"]" Icon="bi bi-graph-up-arrow" Color="var(--success)">
        <Action>@categoriesButton</Action>
        <Value>@(0m.ToString("N2")) €</Value>
        <Foot>@noPrevious</Foot>
    </FinanceKpiCard>

