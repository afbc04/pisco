        <Value>@(0m.ToString("N2")) €</Value>
        <Foot>@noPrevious</Foot>
    </FinanceKpiCard>

    <FinanceKpiCard Label="@R["Fin_Kpi_Result"]" Icon="bi bi-plus-slash-minus" Color="var(--primary)">
        <Value>@(0m.ToString("N2")) €</Value>
        <Foot><span>@R["Fin_Kpi_ResultHint"]</span></Foot>
    </FinanceKpiCard>

    <FinanceKpiCard Label="@R["Fin_Kpi_BalanceNow"]" Icon="bi bi-safe2" Color="var(--balance)">
