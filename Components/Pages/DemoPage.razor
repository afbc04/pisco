@page "/demo"
@inject ToastService Toasts

<PageTitle>Components · Pisco</PageTitle>

<div class="page-head">
    <h1>Components</h1>
    <div class="page-actions">
        <button type="button" class="btn btn-outline-secondary" @onclick='() => Toasts.Info("Just so you know.")'>
            <i class="bi bi-info-circle"></i> Info
        </button>
        <button type="button" class="btn btn-primary" @onclick="openForm">
            <i class="bi bi-plus-lg"></i> Form with validation
        </button>
    </div>
</div>
<p class="text-muted">The app's shared components and styles, to see and try out.</p>

<section class="card card-body mb-3">
    <h5>Page header</h5>
    <p class="text-muted mb-0">The top of this page: title on the left and actions on the right (page-head + page-actions).</p>
</section>

<section class="card card-body mb-3">
    <h5>Notifications</h5>
    <p class="text-muted">They show up in the bottom right corner with a title and a message and go away after 4 seconds (ToastService).</p>
    <div class="d-flex flex-wrap gap-2">
        <button type="button" class="btn btn-outline-secondary" @onclick='() => Toasts.Success("That went well.")'>
            <i class="bi bi-check-circle"></i> Success
        </button>
        <button type="button" class="btn btn-outline-secondary" @onclick='() => Toasts.Error("Something went wrong.")'>
            <i class="bi bi-exclamation-circle"></i> Error
        </button>
        <button type="button" class="btn btn-outline-secondary" @onclick='() => Toasts.Warning("Watch out for this.")'>
            <i class="bi bi-exclamation-triangle"></i> Warning
        </button>
        <button type="button" class="btn btn-outline-secondary" @onclick='() => Toasts.Info("Just so you know.")'>
            <i class="bi bi-info-circle"></i> Info
        </button>
        <button type="button" class="btn btn-outline-secondary" @onclick='() => Toasts.Success("The March invoice was marked as paid.", "Invoice paid")'>
            <i class="bi bi-type"></i> Custom title
        </button>
    </div>
</section>

<section class="card card-body mb-3">
    <h5>Dialogs</h5>
    <p class="text-muted">EntryModal: large for editors, small for confirmations (on phones the small one slides up from the bottom).</p>
    <div class="d-flex flex-wrap gap-2">
        <button type="button" class="btn btn-outline-secondary" @onclick="openLarge">
            <i class="bi bi-window"></i> Large dialog
        </button>
        <button type="button" class="btn btn-outline-secondary" @onclick="openSmall">
            <i class="bi bi-window-stack"></i> Small dialog
        </button>
        <button type="button" class="btn btn-outline-secondary" @onclick="openForm">
            <i class="bi bi-ui-checks"></i> Form with validation
        </button>
        <button type="button" class="btn btn-outline-secondary" @onclick="openTabs">
            <i class="bi bi-layout-sidebar"></i> Modal with side tabs
        </button>
    </div>
</section>

<section class="card card-body mb-3">
    <div class="page-section-head">
        <button type="button" class="page-collapse" aria-expanded="@sectionOpen" @onclick="toggleSection">
            <i class="bi bi-chevron-@(sectionOpen ? "down" : "right")"></i>
            <i class="bi bi-folder2"></i>
            Collapsible section
            <span class="page-collapse-summary">@sectionItems</span>
        </button>
    </div>
    @if (sectionOpen)
    {
        <ul class="mb-0">
            @for (var i = 1; i <= sectionItems; i++)
            {
                <li>@($"Item {i}")</li>
            }
        </ul>
    }
</section>

<section class="card card-body mb-3">
    <h5>Search</h5>
    <div class="filter filter-search mb-2">
        <i class="bi bi-search"></i>
        <input class="form-control" placeholder="Search city…" @bind="search" @bind:event="oninput" />
    </div>
    @if (filteredCities.Any())
    {
        <div class="d-flex flex-wrap gap-2">
            @foreach (var city in filteredCities)
            {
                <span class="badge text-bg-secondary">@city</span>
            }
        </div>
    }
    else
    {
        <p class="text-muted mb-0">Nothing found.</p>
    }
</section>

<section class="card card-body mb-3">
    <h5>Basic elements</h5>

    <div class="d-flex flex-wrap gap-2 mb-3">
        <button type="button" class="btn btn-primary">Save</button>
        <button type="button" class="btn btn-outline-secondary">Cancel</button>
        <button type="button" class="btn btn-outline-danger">Delete</button>
        <button type="button" class="btn btn-primary" disabled>Disabled</button>
        <button type="button" class="btn btn-link px-0"><i class="bi bi-plus-lg"></i> Link</button>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <label class="form-label">Name <span class="required-mark">*</span></label>
            <input class="form-control" placeholder="Name" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Name <span class="required-mark">*</span></label>
            <input class="form-control is-invalid" />
            <div class="invalid-feedback d-block">This field is required.</div>
        </div>
        <div class="col-md-6">
            <label class="form-label">List</label>
            <select class="form-select">
                <option>Lisboa</option>
                <option>Porto</option>
                <option>Braga</option>
            </select>
        </div>
        <div class="col-md-6">
            <label class="form-label">@($"Range: {range}")</label>
            <input type="range" class="form-range" min="0" max="100" @bind="range" @bind:event="oninput" />
        </div>
        <div class="col-12">
            <label class="form-check">
                <input type="checkbox" class="form-check-input" @bind="check" />
                <span class="form-check-label">Option enabled</span>
            </label>
            <p class="form-text mb-0">Help text below a field.</p>
        </div>
        <div class="col-12">
            <label class="form-label">Notes</label>
            <textarea class="form-control" rows="2"></textarea>
        </div>
    </div>

    <div class="alert alert-danger py-2 small">Error message.</div>
    <div class="alert alert-warning py-2 small">Warning message.</div>
    <div class="d-flex flex-wrap gap-2">
        <span class="badge text-bg-warning">Public</span>
        <span class="badge text-bg-secondary">Badge</span>
    </div>
</section>

@if (largeOpen)
{
    <EntryModal Title="Large dialog" OnClose="closeLarge">
        <ChildContent>
            <p>Dialog content. Close it with the ×, with the footer button or by clicking outside.</p>
        </ChildContent>
        <Footer>
            <button type="button" class="btn btn-outline-secondary" @onclick="closeLarge">Close</button>
        </Footer>
    </EntryModal>
}

@if (smallOpen)
{
    <EntryModal Title="Small dialog" Small="true" OnClose="closeSmall">
        <ChildContent>
            <p class="mb-0">Dialog content. Close it with the ×, with the footer button or by clicking outside.</p>
        </ChildContent>
        <Footer>
            <button type="button" class="btn btn-primary" @onclick="confirmSmall">Save</button>
            <button type="button" class="btn btn-outline-secondary" @onclick="closeSmall">Cancel</button>
        </Footer>
    </EntryModal>
}

@if (formOpen)
{
    <EntryModal Title="Form with validation" Small="true" OnClose="closeForm">
        <ChildContent>
            <label class="form-label">Name <span class="required-mark">*</span></label>
            <input class="form-control @(nameInvalid ? "is-invalid" : null)" @bind="name" @bind:after="() => nameInvalid = false" />
            @if (nameInvalid)
            {
                <div class="invalid-feedback d-block">This field is required.</div>
            }
        </ChildContent>
        <Footer>
            <button type="button" class="btn btn-primary" @onclick="saveForm">Save</button>
            <button type="button" class="btn btn-outline-secondary" @onclick="closeForm">Cancel</button>
        </Footer>
    </EntryModal>
}

@if (tabsOpen)
{
    <TabbedModal Title="Modal with side tabs" CollapseLabel="Collapse tabs" ExpandLabel="Expand tabs" @bind-ActiveTab="activeTab" OnClose="closeTabs">
        <ChildContent>
            <TabItem Name="general" Title="General" Icon="sliders">
                <h6>General</h6>
                <label class="form-label">Name</label>
                <input class="form-control mb-3" @bind="name" />
                <label class="form-check">
                    <input type="checkbox" class="form-check-input" @bind="check" />
                    <span class="form-check-label">Option enabled</span>
                </label>
            </TabItem>
            <TabItem Name="notes" Title="Notes" Icon="journal-text" Badge="@notes.Count.ToString()">
                <h6>Notes</h6>
                <ul>
                    @foreach (var note in notes)
                    {
                        <li>@note</li>
                    }
                </ul>
                <button type="button" class="btn btn-link px-0" @onclick='() => notes.Add($"Item {(notes.Count + 1)}")'>
                    <i class="bi bi-plus-lg"></i> Link
                </button>
            </TabItem>
            <TabItem Name="advanced" Title="Advanced" Icon="gear">
                <h6>Advanced</h6>
                <p class="text-muted">Dialog content. Close it with the ×, with the footer button or by clicking outside.</p>
                <label class="form-label">@($"Range: {range}")</label>
                <input type="range" class="form-range" min="0" max="100" @bind="range" @bind:event="oninput" />
            </TabItem>
            <TabItem Name="locked" Title="Disabled" Icon="lock" Disabled="true" />
        </ChildContent>
        <Footer>
            <span class="text-muted small me-auto">@($"Active tab: {(activeTab ?? "general")}")</span>
            <button type="button" class="btn btn-primary" @onclick="closeTabs">Save</button>
            <button type="button" class="btn btn-outline-secondary" @onclick="closeTabs">Cancel</button>
        </Footer>
    </TabbedModal>
}

@code {
    private static readonly string[] cities = ["Lisboa", "Porto", "Braga", "Coimbra", "Faro", "Évora", "Aveiro", "Viseu", "Setúbal", "Leiria"];

    private const int sectionItems = 3;

    private bool largeOpen;
    private bool smallOpen;
    private bool formOpen;
    private bool tabsOpen;
    private string? activeTab;
    private List<string> notes = ["Lisboa", "Porto"];
    private bool sectionOpen = true;

    private string search = "";
    private int range = 40;
    private bool check = true;

    private string name = "";
    private bool nameInvalid;

    private IEnumerable<string> filteredCities =>
        cities.Where(c => c.Contains(search.Trim(), StringComparison.CurrentCultureIgnoreCase));

    private void openForm()
    {
        name = "";
        nameInvalid = false;
        formOpen = true;
    }

    private void saveForm()
    {
        nameInvalid = string.IsNullOrWhiteSpace(name);
        if (nameInvalid)
        {
            Toasts.Error("Fix the highlighted fields.");
            return;
        }
        formOpen = false;
        Toasts.Success($"Saved: {(name.Trim())}");
    }

    private void confirmSmall()
    {
        smallOpen = false;
        Toasts.Success("That went well.");
    }

    private void openLarge() => largeOpen = true;

    private void closeLarge() => largeOpen = false;

    private void openSmall() => smallOpen = true;

    private void closeSmall() => smallOpen = false;

    private void openTabs() => tabsOpen = true;

    private void closeTabs() => tabsOpen = false;

    private void closeForm() => formOpen = false;

    private void toggleSection() => sectionOpen = !sectionOpen;
}
