@page "/parameters"
@attribute [Authorize]
@inject WorkspaceService Workspaces
@inject ConfigService Config
@inject AuthenticationStateProvider AuthProvider
@inject ToastService Toasts

<PageTitle>Parameters · Pisco</PageTitle>

<div class="page-head">
    <h1>Parameters</h1>
</div>

<div class="row g-4 align-items-start">
    <div class="col-lg-7">
        <WorkspacesSettings Workspaces="workspaces" LandingId="config?.LandingWorkspaceId" OnChanged="loadAsync" />
    </div>
    <div class="col-lg-5">
        <ConfigSettings Config="config" Workspaces="workspaces" OnChanged="loadAsync" />
    </div>
</div>

@code {
    private List<Workspace>? workspaces;
    private Domain.Config? config;

    protected override Task OnInitializedAsync() => loadAsync();

    private async Task loadAsync()
    {
        try
        {
            workspaces = await Workspaces.ListAllAsync((await AuthProvider.GetAuthenticationStateAsync()).User);
            config = await Config.GetAsync();
        }
        catch (DomainException ex)
        {
            workspaces = [];
            Toasts.Error(ex.Message);
        }
    }
}
