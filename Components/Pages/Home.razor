@page "/"
@implements IDisposable
@inject WorkspaceState WsState
@inject AuthenticationStateProvider AuthProvider

<PageTitle>Pisco</PageTitle>

<h1>@(userName is null ? "Pisco" : $"Hello, {userName}")</h1>
<p class="text-muted">
    @if (WsState.Current is { } ws)
    {
        @($"Workspace: {ws.Name}")
    }
    else
    {
        <text>You don't have access to any workspace yet. Ask the administrator to add you to one.</text>
    }
</p>

@code {
    private string? userName;

    protected override async Task OnInitializedAsync()
    {
        WsState.Changed += onWsChanged;
        userName = (await AuthProvider.GetAuthenticationStateAsync()).User.Identity?.Name;
        await WsState.EnsureLoadedAsync();
    }

    private void onWsChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => WsState.Changed -= onWsChanged;
}
