@inject ConfigService ConfigSvc
@inject AuthenticationStateProvider AuthProvider
@inject ToastService Toasts

<section class="panel-card">
    <header class="panel-card-head">
        <div>
            <h2 class="panel-card-title"><i class="bi bi-sliders"></i> Configuration</h2>
            <p class="panel-card-hint">General settings, stored in pisco_config.config.</p>
        </div>
    </header>

    <div class="panel-card-body">
        @if (Config is null || publicWorkspaces is null)
        {
            <p class="text-muted m-0">Loading…</p>
        }
        else
        {
            <div class="panel-field">
                <label class="form-label" for="config-username"><i class="bi bi-person-circle"></i> Username</label>
                <input id="config-username" class="form-control form-control-sm" value="@Config.Username" disabled />
                <div class="form-text">The only account; it can be changed in the config table.</div>
            </div>
            <div class="panel-field">
                <label class="form-label" for="config-landing"><i class="bi bi-house"></i> Home workspace</label>
                @if (publicWorkspaces.Count == 0)
                {
                    <input id="config-landing" class="form-control form-control-sm" value="No public workspace" disabled />
                }
                else
                {
                    <select id="config-landing" class="form-select form-select-sm"
                            value="@Config.LandingWorkspaceId" @onchange="setLandingAsync" disabled="@busy">
                        @foreach (var ws in publicWorkspaces)
                        {
                            <option value="@ws.Id">@ws.Name</option>
                        }
                    </select>
                }
                <div class="form-text">Where visitors land. It must be public.</div>
            </div>
        }
    </div>
</section>

@code {
    [Parameter] public Domain.Config? Config { get; set; }
    [Parameter] public List<Workspace>? Workspaces { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private bool busy;

    private List<Workspace>? publicWorkspaces => Workspaces?.Where(w => w.IsPublic).ToList();

    private async Task setLandingAsync(ChangeEventArgs e)
    {
        if (!long.TryParse(e.Value?.ToString(), out var id) || id == Config?.LandingWorkspaceId)
            return;
        busy = true;
        try
        {
            await ConfigSvc.SetLandingAsync(id, (await AuthProvider.GetAuthenticationStateAsync()).User);
            Toasts.Success("Configuration saved.");
        }
        catch (DomainException ex)
        {
            Toasts.Error(ex.Message);
        }
        finally
        {
            busy = false;
            await OnChanged.InvokeAsync();
        }
    }
}
