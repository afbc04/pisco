@using System.Security.Claims
@inject WorkspaceService Workspaces
@inject AuthenticationStateProvider AuthProvider
@inject ToastService Toasts

<EntryModal Title="@((isNew ? "New workspace" : "Edit workspace"))" Small="true" OnClose="OnClose">
    <ChildContent>
        <section class="ws-section">
            <label class="ws-section-title" for="ws-name">Name <span class="required-mark">*</span></label>
            <input id="ws-name" class="form-control @(nameError is null ? null : "is-invalid")" maxlength="@Workspace.NameLengthMax"
                   @bind="name" @bind:event="oninput" @bind:after="() => nameError = null" autofocus />
            @if (nameError is not null)
            {
                <div class="invalid-feedback d-block">@nameError</div>
            }
        </section>

        <section class="ws-section">
            <label class="form-check form-switch mb-0">
                <input type="checkbox" class="form-check-input" role="switch" @bind="isPublic" disabled="@IsLanding" />
                <span class="form-check-label">Public</span>
            </label>
            <p class="ws-hint mb-0 mt-1">@(IsLanding ? "The home workspace must be public." : "Visitors who are not signed in can open it.")</p>
        </section>

        @if (!isNew)
        {
            <section class="ws-section ws-danger">
                <div class="ws-section-title">Delete workspace</div>
                @if (IsLanding)
                {
                    <p class="ws-hint mb-0">The home workspace cannot be deleted: it is what visitors see.</p>
                }
                else if (!confirmDelete)
                {
                    <p class="ws-hint">Deletes the workspace and all of its data. This cannot be undone.</p>
                    <button type="button" class="btn btn-outline-danger btn-sm" @onclick="askDelete">
                        <i class="bi bi-trash3"></i> Delete workspace
                    </button>
                }
                else
                {
                    <p class="ws-hint">Type <strong>@Workspace!.Name</strong> to confirm.</p>
                    <div class="ws-inline">
                        <input class="form-control" aria-label="Delete workspace" @bind="confirmName" @bind:event="oninput" autofocus />
                        <button type="button" class="btn btn-danger" disabled="@(busy || confirmName.Trim() != Workspace.Name)" @onclick="deleteAsync">Delete</button>
                        <button type="button" class="btn btn-outline-secondary" title="Cancel" @onclick="cancelDelete"><i class="bi bi-x-lg"></i></button>
                    </div>
                }
            </section>
        }
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-primary" disabled="@busy" @onclick="saveAsync">@(isNew ? "Create" : "Save")</button>
        <button type="button" class="btn btn-outline-secondary" @onclick="OnClose">Cancel</button>
    </Footer>
</EntryModal>

@code {
    [Parameter] public Workspace? Workspace { get; set; }
    [Parameter] public bool IsLanding { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    [Parameter] public EventCallback<string> OnSaved { get; set; }

    private bool isNew => Workspace is null;

    private ClaimsPrincipal actor = new();
    private string name = "";
    private bool isPublic;
    private string? nameError;
    private bool confirmDelete;
    private string confirmName = "";
    private bool busy;

    protected override async Task OnInitializedAsync()
    {
        actor = (await AuthProvider.GetAuthenticationStateAsync()).User;
        name = Workspace?.Name ?? "";
        isPublic = Workspace?.IsPublic ?? false;
    }

    private Task saveAsync() => runAsync(async () =>
    {
        if (isNew)
        {
            var ws = await Workspaces.CreateAsync(name, isPublic, actor);
            await OnSaved.InvokeAsync($"Workspace \"{ws.Name}\" created.");
        }
        else
        {
            await Workspaces.UpdateAsync(Workspace!.Id, name, isPublic, actor);
            await OnSaved.InvokeAsync("Workspace saved.");
        }
    });

    private Task deleteAsync() => runAsync(async () =>
    {
        await Workspaces.DeleteAsync(Workspace!.Id, actor);
        await OnSaved.InvokeAsync($"Workspace \"{Workspace.Name}\" deleted.");
    });

    private async Task runAsync(Func<Task> action)
    {
        busy = true;
        try
        {
            await action();
        }
        catch (DomainException ex) when (ex.Field == DomainField.Name)
        {
            nameError = ex.Message;
        }
        catch (DomainException ex)
        {
            Toasts.Error(ex.Message);
        }
        finally
        {
            busy = false;
        }
    }

    private void askDelete()
    {
        confirmDelete = true;
        confirmName = "";
    }

    private void cancelDelete() => confirmDelete = false;
}
